{
  "name": "novel-studio",
  "productName": "小说工坊",
  "version": "0.2.1",
  "description": "本地优先的小说创作软件：正文/大纲/人物/设定一站式管理，即时自动保存",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env NOVEL_STUDIO_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "web": "node server.mjs --open",
    "icon": "node scripts/make-icon.mjs",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.novelstudio.app",
    "productName": "小说工坊",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.log"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小说工坊",
      "artifactName": "小说工坊-安装程序-${version}.${ext}",
      "uninstallDisplayName": "小说工坊"
    },
    "portable": {
      "artifactName": "小说工坊-便携版-${version}.${ext}"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "codemirror": "^6.0.1",
    "dexie": "^4.0.11",
    "echarts": "^5.6.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "marked": "^12.0.2",
    "naive-ui": "^2.41.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
